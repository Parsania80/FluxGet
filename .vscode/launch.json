{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "FluxGet: Debug download",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "-url",
                "${input:downloadUrl}",
                "-out",
                "${input:downloadOutput}"
            ]
        }
    ],
    "inputs": [
        {
            "id": "downloadUrl",
            "type": "promptString",
            "description": "File URL, including http:// or https://",
            "default": "http://192.168.137.222/p/backups_20261027133355.zip"
        },
        {
            "id": "downloadOutput",
            "type": "promptString",
            "description": "New output filename or path; existing files are refused",
            "default": "debug-download.json"
        }
    ]
}
