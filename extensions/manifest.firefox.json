{
  "manifest_version": 3,
  "name": "FluxGet Browser Integration",
  "version": "0.1.0",
  "description": "Send public file downloads to FluxGet with per-browser and per-site controls.",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "storage",
    "contextMenus",
    "alarms"
  ],
  "optional_permissions": [
    "webRequest",
    "scripting"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FluxGet",
    "default_icon": {
      "32": "icon.png"
    }
  },
  "incognito": "not_allowed",
  "background": {
    "scripts": [
      "config.js",
      "core.js",
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "fluxget@parsania80.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "128": "icon.png"
  }
}
