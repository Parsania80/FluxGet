{
  "manifest_version": 3,
  "name": "FluxGet Browser Integration",
  "version": "2.0.0",
  "description": "Send public file downloads to FluxGet with per-browser and per-site controls.",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "storage",
    "contextMenus",
    "alarms"
  ],
  "optional_permissions": [
    "webRequest",
    "scripting"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FluxGet",
    "default_icon": {
      "32": "icon.png"
    }
  },
  "incognito": "not_allowed",
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "minimum_chrome_version": "120",
  "icons": {
    "128": "icon.png"
  }
}
